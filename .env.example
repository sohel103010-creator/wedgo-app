# WedGo Flutter — environment template.
# NEVER commit real values. Pass via --dart-define at build time:
#   flutter build apk --release \
#     --dart-define=SUPABASE_URL=https://xyz.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJ...
SUPABASE_URL=
SUPABASE_ANON_KEY=
# FCM (Firebase Cloud Messaging) — REQUIRED for push notifications.
# Set up per README.md § "Push notifications (FCM)". Until configured,
# the app runs without push; fcm_token stays null (no fake tokens).
FCM_ENABLED=false
# Google OAuth (admin Google Sign-In) — Web client ID from Google Cloud Console.
# Must also be allow-listed in Supabase Dashboard > Auth > Providers > Google.
GOOGLE_WEB_CLIENT_ID=
